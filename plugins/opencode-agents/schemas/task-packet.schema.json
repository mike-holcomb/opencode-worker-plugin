{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "tier": {
      "type": "string",
      "enum": [
        "lightweight",
        "standard",
        "full"
      ]
    },
    "authoritative_inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "reference": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "file",
              "artifact",
              "url",
              "inline"
            ]
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "expected_sha256": {
            "type": "string"
          }
        },
        "required": [
          "reference",
          "kind",
          "purpose"
        ],
        "additionalProperties": false
      }
    },
    "context": {
      "type": "object",
      "properties": {
        "verified_facts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rejected_assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "exclusions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "predecessor_task_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "verified_facts",
        "rejected_assumptions",
        "exclusions"
      ],
      "additionalProperties": false
    },
    "allowed_writes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "file",
              "directory"
            ]
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "path",
          "kind",
          "purpose"
        ],
        "additionalProperties": false
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "requirement": {
            "type": "string",
            "minLength": 1
          },
          "evidence_required": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "requirement",
          "evidence_required",
          "required"
        ],
        "additionalProperties": false
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "argv": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "cwd": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "description"
        ],
        "additionalProperties": false
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "stop_conditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "shared_resources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "access": {
            "type": "string",
            "enum": [
              "read",
              "write"
            ]
          }
        },
        "required": [
          "key",
          "access"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "title",
    "objective",
    "tier",
    "authoritative_inputs",
    "context",
    "allowed_writes",
    "acceptance_criteria",
    "checks",
    "constraints",
    "stop_conditions",
    "shared_resources"
  ],
  "additionalProperties": false
}
